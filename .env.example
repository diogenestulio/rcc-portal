# Copie para .env.local (dev) — NUNCA versionar segredos reais.
APP_ENV=development            # development | homologacao | producao
APP_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:dev_only_pw@127.0.0.1:55432/rcc_dev
DB_POOL_MAX=10
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-bytes
# Chave (32 bytes base64) para assinar o encadeamento da auditoria e tokens de download
APP_SIGNING_KEY=troque-por-outra-chave-aleatoria
INSTITUTION_TIMEZONE=America/Cuiaba

# Agenda: decisão de 10/11/2026 = o PORTAL é a fonte de verdade (cms_to_google).
# Fica "off" até existirem as credenciais da agenda Google institucional.
GOOGLE_CALENDAR_MODE=off
GOOGLE_CALENDAR_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=

# Loja: desligada até definição institucional. Provedor: off | simulado (só development)
STORE_ENABLED=false
PAYMENTS_PROVIDER=off
# Retirada local (só se a operação oferecer)
STORE_PICKUP_ENABLED=false
STORE_PICKUP_INFO=

# E-mail transacional por SMTP de qualquer provedor (ver docs/09-integracoes.md).
# Ex.: smtp://usuario:chave@smtp-relay.provedor.com:587 — vazio: dev/homologação gravam .eml; produção recusa.
# Teste local: docker run -d --name rcc-mailpit -p 127.0.0.1:11026:1025 -p 127.0.0.1:18026:8025 axllent/mailpit:v1.27
#   e SMTP_URL=smtp://127.0.0.1:11026 (mensagens em http://127.0.0.1:18026)
SMTP_URL=
MAIL_FROM="RCC Arquidiocese de Cuiabá <nao-responda@exemplo.invalid>"

# Armazenamento de objetos (S3 compatível). Vazio = disco local ./storage (só dev)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Alertas
ALERT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
