# .env da HOMOLOGAÇÃO — gerar no próprio servidor (deploy.sh faz isso na 1ª vez) com permissão 600.
# Nunca reaproveitar segredos do desenvolvimento nem de outros sistemas da VPS.
RCC_VERSAO=__preenchido_pelo_deploy__
APP_ENV=homologacao
APP_URL=https://179-197-73-172.sslip.io:10443
INSTITUTION_TIMEZONE=America/Cuiaba

POSTGRES_DB=rcc_hml
POSTGRES_USER=rcc_hml
POSTGRES_PASSWORD=__openssl_rand_hex_24__
DATABASE_URL=postgres://rcc_hml:__mesma_senha__@postgres:5432/rcc_hml
DB_POOL_MAX=8

BETTER_AUTH_SECRET=__openssl_rand_base64_32__
APP_SIGNING_KEY=__openssl_rand_base64_32__

# Decisões de 10/11/2026: agenda com o portal como fonte de verdade (Google só com credenciais);
# loja e pagamentos adiados.
GOOGLE_CALENDAR_MODE=off
STORE_ENABLED=false
PAYMENTS_PROVIDER=off
SMTP_URL=
ENABLE_HSTS=false
